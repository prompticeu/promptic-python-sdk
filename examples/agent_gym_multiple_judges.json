{
  "name": "Question answering with independent judges",
  "goal": "Answer the question and identify the supporting pages.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "question": {"type": "string"}
    },
    "required": ["question"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "answer": {"type": "string"},
      "pages": {"type": "array", "items": {"type": "integer"}}
    },
    "required": ["answer", "pages"]
  },
  "evaluators": [
    {
      "kind": "ai_judge",
      "id": "answer-quality",
      "name": "Answer quality",
      "weight": 2,
      "field": "answer",
      "instructions": "Check that the answer is accurate and addresses the question."
    },
    {
      "kind": "exact_match",
      "id": "supporting-pages",
      "name": "Supporting pages",
      "weight": 1,
      "field": "pages"
    }
  ]
}
